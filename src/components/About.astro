---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { about, highlights, profile } from '../data/profile';
import { fill } from '../lib/utils';

interface Props {
  index: number;
}

const { index } = Astro.props;
---

<section class="section" id="about">
  <div class="container">
    <SectionHeading index={index} eyebrow="About" title="Engineering that scales — and lasts." highlight="scales" />

    <div class="about-grid">
      <div class="about-copy">
        {
          about.map((p, i) => (
            <p data-reveal style={`--delay: ${i * 80}ms`} class:list={{ lead: i === 0 }}>
              {fill(p)}
            </p>
          ))
        }
        <ul class="facts" data-reveal style="--delay: 240ms">
          <li>
            <Icon name="mapPin" size={17} />
            {profile.location}
          </li>
          <li>
            <Icon name="mail" size={17} />
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </li>
        </ul>
      </div>

      <ul class="highlights">
        {
          highlights.map((h, i) => (
            <li class="card card-lift highlight" data-reveal data-spotlight style={`--delay: ${i * 90}ms`}>
              <span class="icon-medallion">
                <Icon name={h.icon} />
              </span>
              <h3>{h.title}</h3>
              <p>{h.body}</p>
              <ul class="chips">
                {h.tags.map((t) => (
                  <li class="chip chip-neutral">{t}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .about-copy {
    display: grid;
    gap: 20px;
    color: var(--text-muted);
    font-size: 1.05rem;
    position: sticky;
    top: calc(var(--nav-h) + 32px);
  }

  .about-copy .lead {
    color: var(--text);
    font-size: 1.25rem;
    line-height: 1.55;
    font-family: var(--font-display);
    font-weight: 500;
  }

  .facts {
    display: grid;
    gap: 10px;
    margin-top: 8px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .facts :global(svg) {
    color: var(--violet-soft);
  }

  .facts a:hover {
    color: var(--text);
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .highlight {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px;
  }

  .highlight h3 {
    font-size: 1.2rem;
    margin-top: 6px;
  }

  .highlight p {
    color: var(--text-muted);
    font-size: 0.95rem;
    flex: 1;
  }

  @media (max-width: 960px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-copy {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
