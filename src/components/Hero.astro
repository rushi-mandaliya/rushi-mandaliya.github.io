---
import Icon from './Icon.astro';
import { profile, recognition, stats } from '../data/profile';
import { fill, withBase, yearsOfExperience } from '../lib/utils';

const [firstName, ...rest] = profile.name.split(' ');
const lastName = rest.join(' ');
const varName = firstName.toLowerCase();

// ── Build the syntax-highlighted "profile.cs" card from profile data ──
type Tok = [cls: string, text: string];
const kw = (t: string): Tok => ['kw', t];
const ty = (t: string): Tok => ['ty', t];
const pr = (t: string): Tok => ['pr', t];
const st = (t: string): Tok => ['st', `"${t}"`];
const nu = (t: string | number): Tok => ['nu', String(t)];
const pu = (t: string): Tok => ['pu', t];
const cm = (t: string): Tok => ['cm', t];
const sp = (t: string): Tok => ['', t];

const PAD = 9; // property name column width
const prop = (name: string): Tok[] => [sp('    '), pr(name), sp(' '.repeat(Math.max(1, PAD - name.length))), pu('= ')];

// Wrap string arrays so no line gets too wide for the card.
function arrayLines(name: string, items: string[], maxChars = 34): Tok[][] {
  const rows: string[][] = [[]];
  let width = 0;
  for (const item of items) {
    const w = item.length + 4;
    if (width + w > maxChars && rows.at(-1)!.length) {
      rows.push([]);
      width = 0;
    }
    rows.at(-1)!.push(item);
    width += w;
  }
  return rows.map((row, i) => {
    const head = i === 0 ? [...prop(name), pu('[')] : [sp(' '.repeat(4 + PAD + 3))];
    const body = row.flatMap((item, j) => (j < row.length - 1 ? [st(item), pu(', ')] : [st(item)]));
    const tail = i === rows.length - 1 ? [pu('],')] : [pu(',')];
    return [...head, ...body, ...tail];
  });
}

const codeLines: Tok[][] = [
  [kw('var'), sp(` ${varName} `), pu('= '), kw('new '), ty('Engineer')],
  [pu('{')],
  [...prop('Name'), st(profile.name), pu(',')],
  [...prop('Role'), st(profile.status), pu(',')],
  [...prop('Location'), st(profile.location), pu(',')],
  [...prop('Years'), nu(yearsOfExperience), pu(',')],
  ...arrayLines('Stack', profile.heroCode.stack),
  ...arrayLines('Focus', profile.heroCode.focus),
  [pu('};')],
  [],
  [kw('await '), sp(varName), pu('.'), ty('ShipAsync'), pu('();'), cm('  // reliably ✨')],
];

// Pre-rendered so template whitespace can't leak into the <pre>.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const codeHtml = codeLines
  .map(
    (line, i) =>
      `<span class="line"><span class="ln">${i + 1}</span>${line
        .map(([cls, text]) => (cls ? `<span class="${cls}">${esc(text)}</span>` : esc(text)))
        .join('')}</span>`,
  )
  .join('');

const [badgeTop, badgeBottom] = recognition;

const statValue = (v: number | 'years') => (v === 'years' ? yearsOfExperience : v);
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="status" data-reveal>
        <span class="pulse" aria-hidden="true"></span>
        {profile.status}
      </p>

      <h1 class="hero-title" data-reveal style="--delay: 80ms">
        <span class="hello">Hi, I'm</span>
        <span class="name gradient-text">{firstName}</span>
        <span class="name">{lastName}</span>
      </h1>

      <p class="typewriter" data-reveal style="--delay: 160ms">
        <span class="tw-prefix">I build</span>
        <span class="tw-word" data-typewriter={JSON.stringify(profile.typewriter)}>{profile.typewriter[0]}</span><span
          class="caret"
          aria-hidden="true"></span>
      </p>

      <p class="tagline" data-reveal style="--delay: 240ms">{fill(profile.tagline)}</p>

      <div class="cta-row" data-reveal style="--delay: 320ms">
        <a href="#experience" class="btn btn-primary">
          View my work <Icon name="arrowRight" class="icon-shift" />
        </a>
        {
          profile.resumeUrl ? (
            <a href={withBase(profile.resumeUrl)} class="btn btn-ghost" download>
              <Icon name="download" /> Download CV
            </a>
          ) : (
            <a href="#contact" class="btn btn-ghost">
              <Icon name="mail" /> Get in touch
            </a>
          )
        }
      </div>

      <div class="meta-row" data-reveal style="--delay: 400ms">
        <ul class="socials" aria-label="Social links">
          {
            profile.socials.map((s) => (
              <li>
                <a
                  class="icon-btn"
                  href={s.href}
                  aria-label={s.label}
                  title={s.label}
                  {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <Icon name={s.icon} />
                </a>
              </li>
            ))
          }
        </ul>
        <span class="location"><Icon name="mapPin" size={16} /> {profile.location}</span>
      </div>
    </div>

    <div class="hero-visual" data-reveal style="--delay: 200ms">
      <div class="code-card">
        <div class="code-head">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="file"><Icon name="code" size={14} /> profile.cs</span>
          <span class="lang">C#</span>
        </div>
        <pre class="code" aria-label="Profile summary written as C# code"><code set:html={codeHtml} /></pre>
      </div>

      {
        badgeTop && (
          <div class="float-badge badge-top">
            <span class="fb-icon">
              <Icon name={badgeTop.icon} size={18} />
            </span>
            <span>
              <strong>{badgeTop.title}</strong>
              <small>{badgeTop.date}</small>
            </span>
          </div>
        )
      }
      {
        badgeBottom && (
          <div class="float-badge badge-bottom">
            <span class="fb-icon alt">
              <Icon name={badgeBottom.icon} size={18} />
            </span>
            <span>
              <strong>{badgeBottom.title}</strong>
              <small>{badgeBottom.date}</small>
            </span>
          </div>
        )
      }
    </div>
  </div>

  {
    stats.length > 0 && (
      <div class="container">
        <ul class="stats">
          {stats.map((s, i) => (
            <li class="card stat" data-reveal style={`--delay: ${i * 90}ms`}>
              <span class="stat-value">
                <span data-count={statValue(s.value)}>{statValue(s.value)}</span>
                {s.suffix && <span class="stat-suffix">{s.suffix}</span>}
              </span>
              <span class="stat-label">{s.label}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <a href="#about" class="scroll-cue" aria-label="Scroll to about section">
    <span class="mouse"><span class="wheel"></span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 96px));
    padding-bottom: 72px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(48px, 7vw, 80px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(40px, 6vw, 72px);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 12px;
    margin-bottom: 28px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    backdrop-filter: blur(10px);
  }

  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34d399;
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid #34d399;
    animation: ping 2s var(--ease) infinite;
  }

  @keyframes ping {
    from {
      opacity: 0.8;
      transform: scale(0.5);
    }
    to {
      opacity: 0;
      transform: scale(1.8);
    }
  }

  .hero-title {
    display: grid;
    font-size: clamp(2.9rem, 7.4vw, 5.6rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hello {
    font-size: 0.3em;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-muted);
    margin-bottom: 14px;
    font-family: var(--font-mono);
  }

  .name {
    padding-bottom: 0.06em;
  }

  .name.gradient-text {
    background-size: 200% 100%;
    animation: shimmer 8s ease-in-out infinite alternate;
  }

  @keyframes shimmer {
    to {
      background-position: 100% 0;
    }
  }

  .typewriter {
    margin-top: 26px;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.3vw, 1.6rem);
    font-weight: 500;
    min-height: 1.5em;
  }

  .tw-prefix {
    color: var(--text-muted);
    margin-right: 0.35em;
  }

  .tw-word {
    color: var(--text);
    background: linear-gradient(transparent 62%, rgb(34 211 238 / 0.22) 62%);
  }

  .caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 3px;
    vertical-align: -0.12em;
    background: var(--cyan);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .tagline {
    margin-top: 20px;
    max-width: 560px;
    font-size: 1.08rem;
    color: var(--text-muted);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 32px;
  }

  .socials {
    display: flex;
    gap: 10px;
  }

  .location {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  /* ── Code card ── */
  .hero-visual {
    position: relative;
    padding: 28px 12px 44px;
  }

  .hero-visual::before {
    content: '';
    position: absolute;
    inset: 8% 4%;
    z-index: -1;
    border-radius: 40px;
    background: var(--gradient-strong);
    filter: blur(60px);
    opacity: 0.35;
  }

  .code-card {
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--bg-elev) 88%, transparent);
    border: 1px solid var(--border-strong);
    box-shadow:
      var(--shadow),
      0 40px 80px -30px rgb(0 0 0 / 0.6);
    backdrop-filter: blur(16px);
    overflow: hidden;
    transform: perspective(1200px) rotateY(-6deg) rotateX(3deg);
    transition: transform 0.8s var(--ease);
  }

  .hero-visual:hover .code-card {
    transform: perspective(1200px) rotateY(0) rotateX(0);
  }

  .code-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .dots {
    display: flex;
    gap: 7px;
  }

  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .dots i:nth-child(2) {
    background: #febc2e;
  }

  .dots i:nth-child(3) {
    background: #28c840;
  }

  .file {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .lang {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 6px;
    color: var(--chip-text);
    background: var(--chip-bg);
    border: 1px solid var(--chip-border);
  }

  .code {
    margin: 0;
    padding: 20px 20px 24px 0;
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1.05vw, 0.84rem);
    line-height: 1.85;
    overflow-x: auto;
    color: var(--text);
  }

  .code :global(.line) {
    display: block;
    white-space: pre;
  }

  .code :global(.ln) {
    display: inline-block;
    width: 3.2em;
    padding-right: 1.2em;
    text-align: right;
    color: var(--text-dim);
    opacity: 0.6;
    user-select: none;
  }

  .code :global(.kw) {
    color: #c084fc;
  }
  .code :global(.ty) {
    color: #22d3ee;
  }
  .code :global(.pr) {
    color: #93c5fd;
  }
  .code :global(.st) {
    color: #86efac;
  }
  .code :global(.nu) {
    color: #fca5a5;
  }
  .code :global(.pu) {
    color: var(--text-muted);
  }
  .code :global(.cm) {
    color: var(--text-dim);
    font-style: italic;
  }

  :global([data-theme='light']) .code :global(.kw) {
    color: #7c3aed;
  }
  :global([data-theme='light']) .code :global(.ty) {
    color: #0e7490;
  }
  :global([data-theme='light']) .code :global(.pr) {
    color: #1d4ed8;
  }
  :global([data-theme='light']) .code :global(.st) {
    color: #047857;
  }
  :global([data-theme='light']) .code :global(.nu) {
    color: #be123c;
  }

  .float-badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px 10px 10px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--bg-elev) 80%, transparent);
    border: 1px solid var(--border-strong);
    box-shadow: 0 20px 40px -18px rgb(0 0 0 / 0.55);
    backdrop-filter: blur(14px);
    animation: float 6s ease-in-out infinite;
  }

  .float-badge strong {
    display: block;
    font-size: 0.85rem;
    line-height: 1.2;
  }

  .float-badge small {
    font-size: 0.72rem;
    color: var(--text-dim);
  }

  .fb-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    color: #fff;
    background: var(--gradient-strong);
  }

  .fb-icon.alt {
    background: linear-gradient(135deg, #f472b6, #8b5cf6);
  }

  .badge-top {
    top: -6px;
    right: -8px;
  }

  .badge-bottom {
    bottom: 0;
    left: -12px;
    animation-delay: -3s;
  }

  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }

  /* ── Stats ── */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .stat {
    display: grid;
    gap: 6px;
    padding: 22px 24px;
  }

  .stat-value {
    justify-self: start;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 18px;
    translate: -50% 0;
    opacity: 0.7;
    transition: opacity 0.3s;
  }

  .scroll-cue:hover {
    opacity: 1;
  }

  .mouse {
    display: block;
    width: 24px;
    height: 38px;
    border-radius: 14px;
    border: 2px solid var(--border-strong);
    position: relative;
  }

  .wheel {
    position: absolute;
    left: 50%;
    top: 7px;
    width: 3px;
    height: 7px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--cyan);
    animation: wheel 1.8s var(--ease) infinite;
  }

  @keyframes wheel {
    to {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      max-width: 560px;
    }

    .code-card {
      transform: none;
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .hero {
      min-height: auto;
    }

    .badge-top {
      right: 0;
    }

    .badge-bottom {
      left: 0;
    }

    .stat {
      padding: 18px;
    }

    .scroll-cue {
      display: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Typewriter: types each phrase, pauses, deletes, moves on.
  const tw = document.querySelector<HTMLElement>('[data-typewriter]');
  if (tw) {
    const words: string[] = JSON.parse(tw.dataset.typewriter || '[]');
    if (words.length > 1) {
      let wordIndex = 0;
      let charIndex = words[0].length;
      let deleting = true;

      const tick = () => {
        const word = words[wordIndex];
        if (reduceMotion) {
          wordIndex = (wordIndex + 1) % words.length;
          tw.textContent = words[wordIndex];
          return setTimeout(tick, 2600);
        }
        charIndex += deleting ? -1 : 1;
        tw.textContent = word.slice(0, charIndex);

        let delay = deleting ? 35 : 70;
        if (!deleting && charIndex === word.length) {
          deleting = true;
          delay = 2000;
        } else if (deleting && charIndex === 0) {
          deleting = false;
          wordIndex = (wordIndex + 1) % words.length;
          delay = 300;
        }
        setTimeout(tick, delay);
      };
      setTimeout(tick, 2400);
    }
  }
</script>
